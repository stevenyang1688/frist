// AUTOSHOP / LITEST Structured Text FB
// FB_MonthlyCopy.ST
// Purpose: On each month 26 00:00:00 (single rising edge) copy D[500..797] (DINT per room, 2 words) to R[] targets
// according to single-year / double-year and month mapping as specified by user.
// Authoring: Generated by Copilot CLI assistant for stevenyang1688/frist

FUNCTION_BLOCK FB_MonthlyCopy
VAR
  // Local internal variables (non-retained)
  bCond     : BOOL;   // trigger condition (D3==26 && D4==0 && D5==0 && D6==0)
  bEdge     : BOOL;   // rising edge detect (uses M100 as previous-state storage)
  isEvenY   : BOOL;   // true if year is even (double-year)
  month     : INT;    // 1..12
  baseAddr  : INT;    // month base: 1000.. or 5000..
  floorIdx  : INT;    // floor index 2..7
  roomIdx   : INT;    // per-floor room index
  srcFirst  : INT;    // first word address in D[] for a room (low word)
  dstFirst  : INT;    // first word address in R[] for a room (low word)
END_VAR

// --- Time registers (existing in PLC):
// D[1] = Year, D[2] = Month, D[3] = Day, D[4] = Hour, D[5] = Minute, D[6] = Second

// Trigger condition: monthly 26th at 00:00:00
bCond := (D[3] = 26) AND (D[4] = 0) AND (D[5] = 0) AND (D[6] = 0);

// Rising edge detection using internal bit M100 to hold previous condition.
// NOTE: M100 is an internal bit. If you require retain across power cycle, mark M100 as Retain in the project.
bEdge := bCond AND NOT M100;

IF bEdge THEN
  // Determine year parity and month
  isEvenY := (D[1] MOD 2 = 0); // TRUE = double year
  month := D[2];
  IF (month < 1) OR (month > 12) THEN
    month := 1; // safety
  END_IF;

  // Base address per month (step = 300 per month as agreed)
  IF isEvenY THEN
    baseAddr := 5000 + (month - 1) * 300; // double-year base
  ELSE
    baseAddr := 1000 + (month - 1) * 300; // single-year base
  END_IF;

  // Copy rooms to R[] according to floor/room layout
  // Layout: floor 2 has 10 rooms (201..210) -> roomIdx 1..10
  // floors 3..7 have 24 rooms each (301..324 etc) -> roomIdx 1..24
  // Source mapping: each room is DINT occupying two D words: srcFirst = 500 + (floor-2)*50 + (roomIdx-1)*2
  // Valid source range: D[500] .. D[797]

  // Floor 2 (10 rooms)
  floorIdx := 2;
  FOR roomIdx := 1 TO 10 DO
    srcFirst := 500 + (floorIdx - 2) * 50 + (roomIdx - 1) * 2;
    IF (srcFirst >= 500) AND (srcFirst + 1 <= 797) THEN
      dstFirst := baseAddr + (floorIdx - 2) * 50 + (roomIdx * 2 - 1);
      // Write low word then high word to R[] (internal holding registers)
      R[dstFirst]     := D[srcFirst];
      R[dstFirst + 1] := D[srcFirst + 1];
    END_IF;
  END_FOR;

  // Floors 3..7 (24 rooms each)
  FOR floorIdx := 3 TO 7 DO
    FOR roomIdx := 1 TO 24 DO
      srcFirst := 500 + (floorIdx - 2) * 50 + (roomIdx - 1) * 2;
      IF (srcFirst >= 500) AND (srcFirst + 1 <= 797) THEN
        dstFirst := baseAddr + (floorIdx - 2) * 50 + (roomIdx * 2 - 1);
        R[dstFirst]     := D[srcFirst];
        R[dstFirst + 1] := D[srcFirst + 1];
      END_IF;
    END_FOR;
  END_FOR;
END_IF;

// Persist current trigger condition into M100 for next scan edge detection
// If you want M100 retained across power cycles, mark M100 as Retain in the project variables
M100 := bCond;

END_FUNCTION_BLOCK
